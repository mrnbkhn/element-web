.mx_TabbedView_tabsOnLeft {
    .mx_TabbedView_tabLabel:hover,
    .mx_TabbedView_tabLabel_active {
        color: $vt-orange;

        .mx_TabbedView_maskedIcon::before {
            background-color: $vt-orange;
        }
    }

    .mx_TabbedView_tabLabel_active {
        background-color: var(--cpd-color-bg-subtle-secondary);
    }
}

.mx_TabbedView_tabLabels {
    color: $basaltic-grey;
}

.mx_TabbedView_maskedIcon::before {
    background-color: $basaltic-grey;
}

/* roomlist item border */
.mx_RoomListItemView {
    .mx_RoomListItemView_content {
        border-bottom-color: transparent;
        .mx_RoomListItemView_messagePreview {
            color: var(--cpd-color-text-secondary);
        }
    }
}
.mx_RoomListItemView_selected {
    background-color: var(--cpd-color-bg-action-secondary-pressed);
}

/* left border color selected event tile in timeline */
.mx_EventTile[data-layout="irc"].mx_EventTile_isEditing > .mx_EventTile_line,
.mx_EventTile[data-layout="irc"].mx_EventTile_selected > .mx_EventTile_line,
.mx_EventTile[data-layout="group"].mx_EventTile_isEditing > .mx_EventTile_line,
.mx_EventTile[data-layout="group"].mx_EventTile_selected > .mx_EventTile_line {
    box-shadow: inset var(--EventTile-box-shadow-offset-x) 0 0 var(--EventTile-box-shadow-spread-radius) $vt-orange;
}

/* non-enabled toggles */
._ui_udcm8_34 {
    background-color: $border-grey;
    border-color: $vt-orange-lighter;
}
._ui_udcm8_34::after {
    --dot-color: $white;
}

/* contextual menu opened by pressing ... icon in MessageAction bar */
.mx_ContextualMenu:hover {
    border-color: $vt-orange;
}

/* room options/new converstation/more options popup menu */
[data-radix-menu-content] ._item_dyt4i_8 {
    border-color: $vt-orange;
}

/* bg overlay if a contextual menu is opened */
/* .mx_ContextualMenu_background {
    background-color: hsla(32, 100%, 50%, 0.235);
} */

/* import & export icons in Encryption tab in settings, explore icon in explore button, + icon in Add extension button, invite icon in Invite button */
._button_187yx_8[data-kind="secondary"] > svg {
    color: $purple;
}

/* RoomList search animation */
.mx_RoomListSearch {
    .mx_RoomListSearch_search {
        background-color: $vt-orange;
        border-color: transparent;
        color: $white;
        transition:
            background-color 0.2s ease,
            color 0.2s ease;
        svg {
            fill: $white;
            transition: fill 0.2s ease;
        }
    }
}
.mx_RoomListSearch {
    .mx_RoomListSearch_search:hover {
        background-color: $white;
        color: $vt-orange;
        svg {
            fill: $vt-orange;
        }
    }
}

/* RoomSummaryCard search animation */
.mx_RoomSummaryCard_search {
    ._search_b2pjl_8 {
        background-color: $vt-orange;
        border: 1px solid transparent;
        transition: background-color 0.2s ease, border-color 0.2s ease;
    }

    svg {
        fill: $white;
        transition: fill 0.2s ease;
    }

    input {
        color: $white;
        caret-color: $white;
        transition: color 0.2s ease, caret-color 0.2s ease;
    }

    input::placeholder {
        color: $white;
        transition: color 0.2s ease;
    }
}

@media (hover) {
    .mx_RoomSummaryCard_search:hover {
        ._search_b2pjl_8:hover {
            background-color: $white;
            border-color: $vt-orange;
        }

        svg {
            fill: $vt-orange;
        }

        input {
            color: $vt-orange;
            caret-color: $vt-orange;
        }

        ._input_b2pjl_52::placeholder {
            color: $vt-orange;
        }
    }
}

/* placeholder text color when hovered on search bar */
/* @media (hover) {
  ._search_b2pjl_8:hover ._input_b2pjl_52::placeholder {
    color: $vt-orange;
  }
} */

@media (hover) {
    .mx_RoomSummaryCard_search:hover:focus-within {
        ._search_b2pjl_8 {
            background-color: $white;
            border-color: $vt-orange;
        }

        svg {
            fill: $vt-orange;
        }

        input {
            color: $vt-orange;
            caret-color: $vt-orange;
        }

        input::placeholder {
            color: $vt-orange;
        }
    }
}

@media (hover) {
    .mx_RoomSummaryCard_search:hover
    ._input_b2pjl_52::-webkit-search-cancel-button {
        filter: invert(45%) sepia(95%) saturate(1800%) hue-rotate(5deg);
    }
}
.mx_RoomSummaryCard_search:focus-within:not(:hover)
._input_b2pjl_52::-webkit-search-cancel-button {
    filter: invert(1) brightness(1.2);
}


.mx_RoomSummaryCard_search:focus-within:not(:hover) {
    ._search_b2pjl_8 {
        background-color: $vt-orange;
        border-color: transparent;
    }

    svg {
        fill: $white;
    }

    input {
        color: $white;
        caret-color: $white;
    }

    input::placeholder {
        color: $white;
    }
}






.mx_Field {
    label {
        color: $mint;
    }
    input[type="text"]:hover {
        color: $pinky;
    }
}

.mx_Field {
    input:focus {
        color: $purple;
    }
}
