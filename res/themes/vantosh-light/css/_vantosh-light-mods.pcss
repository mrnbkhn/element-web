/* conectivity lost to server lost warning icon color */
.mx_RoomStatusBar_connectionLostBar svg {
    color: var(--cpd-color-icon-critical-primary);
}

/* Roomlist panel */

.mx_RoomListPanel {
    background-color: $grey-white;
}

/* trash icon voice record */
.mx_VoiceRecordComposerTile_delete svg {
    color: $bloody;
}

