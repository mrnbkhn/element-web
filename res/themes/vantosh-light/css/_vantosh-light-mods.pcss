/* poll icon in poll */
.mx_MPollBody legend svg {
    color: var(--cfg-blue-700);
}

/* trash can icon next to deleted message in timeline */
.mx_RedactedBody::before {
    background-color: $bloody;
}

.mx_Dialog_title {
    color: $vt-orange;
}

/* circular close button in dialog windows */
.mx_Dialog_cancelButton {
    border-radius: 50%;
    transition:
        background-color 0.2s ease,
        border-color 0.2s ease;
}
.mx_Dialog_cancelButton::before {
    color: $vt-orange;
    transition: background-color 0.2s ease;
}
.mx_Dialog_cancelButton:hover {
    background-color: $vt-orange;
    border-color: transparent;
}
.mx_Dialog_cancelButton:hover::before {
    background-color: $white;
}

/* circular button (close, roomlist filter, back...) */
._icon-button_1pz9o_8[data-kind="secondary"] {
    border: 1px solid $vt-orange-lighter;
    background-color: var(--cpd-color-bg-subtle-secondary);
    transition: background-color 0.2s ease;
}
._icon-button_1pz9o_8[data-kind="secondary"] svg {
    fill: $vt-orange;
    transition: fill 0.2s ease;
}
._icon-button_1pz9o_8[data-kind="secondary"]:hover {
    background-color: $vt-orange;
    border: none;
}
._icon-button_1pz9o_8[data-kind="secondary"]:hover svg {
    fill: $white;
}

.mx_Dialog_cancelButton {
    border: 1px solid $vt-orange-lighter;
}

/* icon colors & border colors in MessageActionBar */
.mx_MessageActionBar {
    border: var(--cpd-border-width-1) solid var(--cpd-color-border-interactive-secondary);
    &:hover {
        border-color: var(--cpd-color-border-interactive-primary);
    }
}
.mx_MessageActionBar_iconButton {
    svg {
        color: var(--cpd-color-icon-tertiary);
    }
    &:hover svg {
        color: var(--cpd-color-icon-primary);
    }
}

.mx_ThreadPanel_replies_amount {
    color: var(--cpd-color-text-primary);
}

/* rest state color icon in space create dialog */
.mx_SpaceCreateMenuType::before {
    background-color: var(--cfg-blue-600);
}

/** MessageComposer custimizations **/
.mx_MessageComposer_sendMessage {
    background-color: $frost-light;
    &:hover {
        background-color: $frost;
    }
}
/* icons in MessageComposer context menu */
.mx_IconizedContextMenu_item path {
    fill: $vt-orange;
}

/** Timeline customizations **/
/* chat timeline and message timestamp */
.mx_TimelineSeparator > hr {
    border-bottom-color: $muted-grey;
}

.mx_DateSeparator_dateHeading {
    color: $footer-grey;
}

/* text color room title in RoomHeader */
/* .mx_RoomHeader_truncated {
    color: $foot;
} */

